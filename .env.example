# Comma-separated dashboard origins allowed by the local FastAPI service.
MOTIONIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Set the API origin used by the React app. Add the frontend origin to the backend
# list above when the UI and API are hosted on different origins.
VITE_API_URL=http://localhost:8000

# Sample analyzed frames at this many frames per second.
MOTIONIQ_SAMPLE_FPS=3
